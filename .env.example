PROJECT_NAME=template # Debes reemplazar 'template' por el nombre de tu proyecto

POSTGRES_USER=user_postgresql # Debes reemplazar 'user_postgresql' por el nombre de usuario root definido para PostgreSQL (recomendado)
POSTGRES_PASSWORD=password # Debes reemplazar 'password' por una generada con 'openssl rand -hex 32' (recomendado)
POSTGRES_DB=core_db # Nombre de la base de datos principal